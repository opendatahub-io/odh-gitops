diff --git a/charts/rhai-on-openshift-chart/charts/grid-enrollment/templates/enrollment/invite-admission.yaml b/charts/rhai-on-openshift-chart/charts/grid-enrollment/templates/enrollment/invite-admission.yaml
new file mode 100644
--- /dev/null
+++ b/charts/rhai-on-openshift-chart/charts/grid-enrollment/templates/enrollment/invite-admission.yaml
@@ -0,0 +1,50 @@
+{{- include "grid-enrollment.normalize" . }}
+{{- if .Values.invites }}
+{{- $fullname := include "grid-enrollment.fullname" . }}
+{{- $sa := printf "%s-invite" ($fullname | trunc 56 | trimSuffix "-") }}
+{{- $name := printf "%s-%s-invite-secrets" $fullname .Release.Namespace }}
+{{- $names := list }}
+{{- range .Values.invites }}
+{{- $names = append $names (printf "grid-invite-%s" .siteName) }}
+{{- end }}
+apiVersion: admissionregistration.k8s.io/v1
+kind: ValidatingAdmissionPolicy
+metadata:
+  name: {{ $name }}
+  labels:
+    {{- include "grid-enrollment.labels" . | nindent 4 }}
+spec:
+  failurePolicy: Fail
+  matchConstraints:
+    resourceRules:
+      - apiGroups: [""]
+        apiVersions: ["v1"]
+        operations: ["CREATE", "UPDATE"]
+        resources: ["secrets"]
+  matchConditions:
+    - name: invite-service-account
+      expression: {{ printf "request.userInfo.username == %q" (printf "system:serviceaccount:%s:%s" .Release.Namespace $sa) | quote }}
+  validations:
+    - expression: {{ printf "object.metadata.namespace == %q && object.metadata.name in %s" .Release.Namespace (toJson $names) | quote }}
+      message: "the invite Job may only write its configured invite Secrets"
+      reason: Forbidden
+    - expression: "!has(object.type) || object.type == '' || object.type == 'Opaque'"
+      message: "invite Secrets must be Opaque; ServiceAccount tokens are forbidden"
+      reason: Forbidden
+    - expression: >-
+        !has(object.metadata.annotations) ||
+        (!('kubernetes.io/service-account.name' in object.metadata.annotations) &&
+         !('kubernetes.io/service-account.uid' in object.metadata.annotations))
+      message: "invite Secrets cannot request ServiceAccount tokens"
+      reason: Forbidden
+---
+apiVersion: admissionregistration.k8s.io/v1
+kind: ValidatingAdmissionPolicyBinding
+metadata:
+  name: {{ $name }}
+  labels:
+    {{- include "grid-enrollment.labels" . | nindent 4 }}
+spec:
+  policyName: {{ $name }}
+  validationActions: [Deny]
+{{- end }}
diff --git a/charts/rhai-on-openshift-chart/charts/grid-enrollment/templates/networkpolicy.yaml b/charts/rhai-on-openshift-chart/charts/grid-enrollment/templates/networkpolicy.yaml
new file mode 100644
--- /dev/null
+++ b/charts/rhai-on-openshift-chart/charts/grid-enrollment/templates/networkpolicy.yaml
@@ -0,0 +1,60 @@
+{{- include "grid-enrollment.normalize" . }}
+{{- $v := .Values }}
+{{- if and $v.networkPolicy.enabled (has $v.enrollment.service.type (list "LoadBalancer" "NodePort")) (not (include "grid-enrollment.routeEnabled" .)) (not $v.networkPolicy.from) }}
+{{- fail "networkPolicy.from requires explicit enrollment clients for LoadBalancer or NodePort without a Route" }}
+{{- end }}
+{{- if .Values.networkPolicy.enabled }}
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: {{ include "grid-enrollment.fullname" . }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "grid-enrollment.labels" . | nindent 4 }}
+spec:
+  podSelector:
+    matchLabels:
+      {{- include "grid-enrollment.enrollmentSelectorLabels" . | nindent 6 }}
+  policyTypes: [Ingress]
+  ingress:
+    - from:
+        # The release's invite Job calls enrollment over HTTPS.
+        - podSelector:
+            matchLabels:
+              {{- include "grid-enrollment.selectorLabels" . | nindent 14 }}
+              app.kubernetes.io/component: invite
+        {{- if include "grid-enrollment.routeEnabled" . }}
+        - namespaceSelector:
+            {{- toYaml .Values.networkPolicy.routerNamespaceSelector | nindent 12 }}
+        {{- end }}
+        {{- with .Values.networkPolicy.from }}
+        {{- toYaml . | nindent 8 }}
+        {{- end }}
+      ports:
+        - port: {{ include "grid-enrollment.listenPort" . }}
+          protocol: TCP
+{{- if eq .Values.db.type "builtin" }}
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: {{ include "grid-enrollment.dbHost" . }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "grid-enrollment.labels" . | nindent 4 }}
+spec:
+  podSelector:
+    matchLabels:
+      {{- include "grid-enrollment.selectorLabels" . | nindent 6 }}
+      app.kubernetes.io/component: db
+  policyTypes: [Ingress]
+  ingress:
+    - from:
+        - podSelector:
+            matchLabels:
+              {{- include "grid-enrollment.enrollmentSelectorLabels" . | nindent 14 }}
+      ports:
+        - port: 5432
+          protocol: TCP
+{{- end }}
+{{- end }}
