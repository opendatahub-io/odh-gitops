# pkg and bin directories currently contain build artifacts
# only so we exclude them.
bin/
vendor/

.vscode/
.idea/

# Compiled python files.
*.pyc

# Emacs temporary files
*~

# Other temporary files
.DS_Store

# temporary files from emacs flymd-mode
flymd.*

# vim .swp files
*.swp
*.swo

# Ignore temporary files created by the Makefile
*.mktmp.*

# Ignore version-specific values files
charts/rhai-on-xks-chart/values-rhoai-*.yaml

# Helm subchart package (regenerated by helm dependency build)
charts/rhai-on-xks-chart/charts/cert-manager-operator-*.tgz

# graphify output
graphify-out/

# Local agent context (operator reference clones, plan files)
.context/
