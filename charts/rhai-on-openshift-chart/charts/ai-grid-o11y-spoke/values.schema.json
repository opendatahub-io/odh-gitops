{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ai-grid-o11y-spoke values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values Helm passes to every subchart."
    },
    "enabled": { "type": "boolean" },
    "collector": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "createNamespace": { "type": "boolean" }
      },
      "required": ["namespace", "port"],
      "additionalProperties": false
    },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "credential": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "token": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tenantMetrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "portalServiceAccountNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "image": { "type": "string" },
        "upstreamURL": { "type": "string" },
        "hubRelay": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "tlsVerifyDepth": { "type": "integer", "minimum": 1 }
          },
          "required": ["image", "port", "tlsVerifyDepth"],
          "additionalProperties": false
        },
        "upstreamCAConfigMap": { "type": "string", "minLength": 1 },
        "upstreamCAConfigMapKey": { "type": "string", "minLength": 1 },
        "auth": {
          "type": "object",
          "properties": {
            "issuerURL": { "type": "string" },
            "clientID": { "type": "string" },
            "tenantAdminRole": { "type": "string" }
          },
          "required": ["issuerURL", "clientID", "tenantAdminRole"],
          "additionalProperties": false
        },
        "gateway": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "sectionName": { "type": "string", "minLength": 1 },
            "hostname": { "type": "string" }
          },
          "required": ["name", "namespace", "sectionName"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "portalServiceAccountNamespace", "image", "upstreamURL", "hubRelay", "upstreamCAConfigMap", "upstreamCAConfigMapKey", "auth", "gateway"],
      "additionalProperties": false
    }
  },
  "required": ["collector"],
  "additionalProperties": false
}
