{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "service",
        "external"
      ]
    },
    "gridIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "configMapName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "configMapName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "networkName": {
          "description": "Deprecated and ignored. Bootstrap reads no GridNetwork.",
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sites",
        "delivery",
        "certManager"
      ],
      "properties": {
        "sites": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]{0,49}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "dnsNames": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              },
              "cluster": {
                "type": "string",
                "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              }
            }
          }
        },
        "trustBundleSecretRef": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "trustBundleSecretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
            },
            "clusterSet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "identitySecretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "caSecretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "createClusterSetBinding": {
              "type": "boolean"
            },
            "includeLocalCluster": {
              "type": "boolean"
            }
          }
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "create",
                "name",
                "kind",
                "group"
              ]
            },
            "ca": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "Existing",
                    "Generate"
                  ]
                },
                "secretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "certificateName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "bootstrapIssuerName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "commonName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "durationHours": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 876000
                },
                "renewBeforeHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 875999
                }
              }
            },
            "certificate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "durationHours": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 876000
                },
                "renewBeforeHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 875999
                }
              }
            }
          },
          "required": [
            "enabled",
            "issuer",
            "ca",
            "certificate"
          ]
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "enum": [
            true,
            false,
            "true",
            "false",
            "auto"
          ],
          "description": "auto renders the Route when route.openshift.io/v1 is served."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
          "description": "DNS-1123 subdomain, no wildcard: it becomes a serving cert SAN."
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "concurrentTcp": {
              "type": "integer",
              "minimum": 1
            },
            "rateTcp": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "termination": {
              "enum": [
                "passthrough",
                "reencrypt"
              ]
            },
            "insecureEdgeTerminationPolicy": {
              "enum": [
                "None",
                "Redirect",
                "Allow",
                ""
              ]
            },
            "destinationCACertificate": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ca": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "builtin",
            "provided"
          ]
        },
        "commonName": {
          "type": "string"
        },
        "keySecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "bundleSecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "forceRegenerate": {
          "type": "boolean"
        },
        "confirmRotation": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "provided": {
          "type": "object",
          "properties": {
            "keySecretRef": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "ttlSecondsAfterFinished": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "resources": {
              "$ref": "#/definitions/resourceBudget"
            },
            "policy": {
              "description": "ValidatingAdmissionPolicy confining the bootstrap to the Secret names this chart renders.",
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "resources"
          ]
        }
      },
      "required": [
        "method",
        "commonName",
        "keySecretName",
        "bundleSecretName"
      ],
      "additionalProperties": false
    },
    "serving": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "existingSecretRef": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "extraDnsNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "enrollment": {
      "type": "object",
      "properties": {
        "authz": {
          "type": "string",
          "enum": [
            "local",
            "kube"
          ]
        },
        "gridAdmins": {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "User",
                      "Group",
                      "ServiceAccount"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "^system:(masters|authenticated|unauthenticated|serviceaccounts)(:.*)?$"
                    }
                  },
                  "namespace": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                  }
                },
                "additionalProperties": false
              }
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "enrollmentAdmins": {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "User",
                      "Group",
                      "ServiceAccount"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "^system:(masters|authenticated|unauthenticated|serviceaccounts)(:.*)?$"
                    }
                  },
                  "namespace": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "tokenAudience": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$",
          "not": {
            "enum": [
              "kubernetes",
              "https://kubernetes.default.svc",
              "https://kubernetes.default.svc/",
              "https://kubernetes.default.svc.cluster.local",
              "https://kubernetes.default.svc.cluster.local/"
            ]
          }
        },
        "listenAddr": {
          "type": "string"
        },
        "replicaCount": {
          "type": "integer"
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "certLifetimeSecs": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Leaf lifetime in seconds. Empty keeps the service default, 180 days."
        },
        "gridAdminTokens": {
          "type": "object",
          "properties": {
            "generate": {
              "type": "boolean"
            },
            "existingSecretRef": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "",
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ],
              "description": "Empty: LoadBalancer when host is set and no Route renders, else ClusterIP."
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "loadBalancerSourceRanges": {
              "description": "CIDRs allowed to reach a LoadBalancer enrollment endpoint.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "$ref": "#/definitions/resourceBudget"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "csrRecord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "signerName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.-]+/[A-Za-z0-9._-]+$"
            }
          }
        },
        "inviteSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "resources"
      ]
    },
    "db": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "builtin",
            "external"
          ]
        },
        "builtin": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "imageDigest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "type": "string"
            },
            "storage": {
              "type": "string"
            },
            "pvcAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "resources": {
              "$ref": "#/definitions/resourceBudget"
            },
            "auth": {
              "type": "object",
              "properties": {
                "database": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                },
                "existingSecretRef": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "tls": {
              "type": "object",
              "properties": {
                "servingSecretName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "resources"
          ]
        },
        "external": {
          "type": "object",
          "properties": {
            "connectionUrlSecretRef": {
              "type": "string"
            },
            "connectionUrlSecretKey": {
              "type": "string"
            },
            "caConfigMapName": {
              "type": "string"
            },
            "caConfigMapKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "if": {
        "properties": {
          "type": {
            "const": "external"
          }
        }
      },
      "then": {
        "properties": {
          "external": {
            "properties": {
              "connectionUrlSecretRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "connectionUrlSecretRef"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "invites": {
      "description": "Sites to invite, keyed by site name, or the older list of {siteName, gridNetworkRef, expiresInSecs}.",
      "type": [
        "object",
        "array"
      ],
      "oneOf": [
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]{0,49}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "network": {
                "type": "string",
                "minLength": 1
              },
              "expiresInSecs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 604800
              },
              "allowDeletedName": {
                "type": "boolean",
                "description": "Mint a token that may enroll a name whose enrollment was deleted."
              },
              "cluster": {
                "type": "string",
                "description": "ManagedCluster name to target when it differs from the site name.",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "siteName",
              "gridNetworkRef"
            ],
            "properties": {
              "siteName": {
                "type": "string",
                "description": "Site name the token pins, a DNS label short enough for the Secret name.",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,49}[a-z0-9])?$"
              },
              "gridNetworkRef": {
                "type": "string",
                "minLength": 1
              },
              "expiresInSecs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 604800
              },
              "allowDeletedName": {
                "type": "boolean",
                "description": "Mint a token that may enroll a name whose enrollment was deleted."
              },
              "cluster": {
                "type": "string",
                "description": "ManagedCluster name to target when it differs from the site name.",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              }
            }
          }
        }
      ]
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "Swim",
                "Local"
              ],
              "description": "Where sites learn their members, Swim or Local. Local creates and delivers no SWIM key."
            }
          }
        }
      }
    },
    "hubSite": {
      "description": "Issue the hub's own site identity straight from the grid CA, so the hub never enrolls.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Site name of the hub. Empty disables it.",
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,49}[a-z0-9])?$"
        },
        "namespace": {
          "description": "Namespace of the hub's grid operator, where the identity Secrets go. Must exist before install.",
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "identitySecretName": {
          "description": "Secret for the site identity.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "caSecretName": {
          "description": "Secret for the grid CA beside the identity.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "swimKeySecretName": {
          "description": "Secret for the grid's SWIM key, created once in the release and hub namespaces. Empty skips it.",
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "seedSecretName": {
          "description": "Secret for the CA-signed seed that registers the hub's key so it can rotate.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "maxLength": 253
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "enabled": {
      "type": "boolean",
      "description": "Subchart toggle set by a parent chart's dependency condition."
    },
    "global": {
      "type": "object",
      "description": "Global values Helm passes to every subchart."
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
      "description": "The enrollment name sites connect to: a serving cert name and the default route.host."
    },
    "platform": {
      "description": "Cloud whose load balancer settings LoadBalancer Services get: aws, azure, gcp, or any for all three, since each cloud reads only its own keys.",
      "type": "string",
      "enum": [
