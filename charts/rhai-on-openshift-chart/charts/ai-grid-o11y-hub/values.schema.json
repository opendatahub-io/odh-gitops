{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ai-grid-o11y-hub values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values Helm passes to every subchart."
    },
    "enabled": {
      "type": "boolean"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "createNamespace": {
      "type": "boolean"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lokiStack": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "size": {
          "type": "string",
          "enum": [
            "1x.demo",
            "1x.pico",
            "1x.extra-small",
            "1x.small",
            "1x.medium"
          ]
        },
        "storageClassName": {
          "type": "string",
          "minLength": 1
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "enum": [
                  "v11",
                  "v12",
                  "v13"
                ]
              },
              "effectiveDate": {
                "type": "string"
              }
            },
            "required": [
              "version",
              "effectiveDate"
            ],
            "additionalProperties": false
          }
        },
        "limits": {
          "type": "object"
        },
        "template": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "size",
        "storageClassName",
        "schemas"
      ],
      "additionalProperties": false
    },
    "objectStorage": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string"
        },
        "secret": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "bucketNames": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "accessKeyId": {
              "type": "string"
            },
            "accessKeySecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "obc": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "generateBucketName": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "serviceCA": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "configMapName": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingest": {
      "type": "object",
      "properties": {
        "writer": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "serviceAccountName": {
              "type": "string",
              "maxLength": 253
            }
          },
          "additionalProperties": false
        },
        "reader": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "serviceAccountName": {
              "type": "string",
              "maxLength": 253
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spokePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "createNamespace": {
          "type": "boolean"
        },
        "deliverCredential": {
          "type": "boolean",
          "description": "Deliver the credential Secret to each spoke."
        },
        "deliverConfiguration": {
          "type": "boolean",
          "description": "Deliver the usageLogs patch to each spoke DSCInitialization."
        },
        "endpoint": {
          "type": "string",
          "pattern": "^(https://.*)?$",
          "description": "HTTPS ingest endpoint with a hostname and the exact /api/logs/v1/infrastructure/otlp path, without a query or fragment. Empty is allowed for deliverConfiguration: false."
        },
        "credentialSecretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "remediationAction": {
          "type": "string",
          "enum": [
            "enforce",
            "inform"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "pruneObjectBehavior": {
          "type": "string",
          "enum": [
            "DeleteIfCreated",
            "DeleteAll",
            "None"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "placement": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "clusterSet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "createClusterSetBinding": {
              "type": "boolean"
            },
            "matchLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            "excludeLocalCluster": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "spoke": {
          "type": "object",
          "properties": {
            "monitoringNamespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "credentialSecretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "dsciName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "exporterName": {
              "type": "string",
              "minLength": 1
            },
            "attributes": {
              "type": "object",
              "maxProperties": 20,
              "additionalProperties": {
                "type": "string"
              }
            },
            "size": {
              "type": "string",
              "enum": [
                "",
                "1x.demo",
                "1x.pico",
                "1x.extra-small",
                "1x.small",
                "1x.medium"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
